#include <windows.h>

#define IDD_HOOK_SELECT 107

IDD_HOOK_SELECT DIALOGEX 0, 0, 220, 162
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "게임 후킹 대상 선택"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "텍스트를 읽어올 게임 창을 선택하세요:", -1, 8, 6, 204, 10
    LISTBOX         6001, 8, 18, 204, 112, WS_VSCROLL | WS_BORDER | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON      "새로 고침", 6010, 8, 136, 60, 15
    DEFPUSHBUTTON   "연결", 6011, 120, 136, 45, 15
    PUSHBUTTON      "취소", IDCANCEL, 168, 136, 44, 15
END
